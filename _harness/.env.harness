# Harness configuration. Sourced by _harness/scripts/lib.sh and exported to
# the api and worker processes of every sandbox.
#
# Every value here is FAKE or local-only. Never copy a value from a real env
# file into this one, and never point anything here at a real environment.
#
# Per-sandbox values are NOT here: lib.sh derives them from the sandbox name
# and its slot (HTTP_ADDR, GRPC_ADDR, DATABASE_URL, KAFKA_TOPIC_PREFIX,
# KAFKA_GROUP_ID, HARNESS_API_URL, HARNESS_MOCK_PREFIX, ...). See
# docs/agent/harness.md.

# ---- App config (see internal/platform/config/config.go) ---------------------
# An empty JSON file, so the committed configs/config.json (the dev profile)
# can't leak into the harness: defaults < this file < the env vars below.
CONFIG_PATH=_harness/config.harness.json
APP_ENV=harness
LOG_LEVEL=info
LOG_FORMAT=json

# Retries can't be switched off (0 means "default", i.e. 3), so use one fast
# hop: a failing handler reaches the DLQ in well under a second instead of
# after ~7s of backoff.
KAFKA_MAX_RETRIES=1
KAFKA_RETRY_BASE_DELAY=100ms
KAFKA_RETRY_MAX_DELAY=100ms

# Fast relay so async checks don't wait on the poll interval.
OUTBOX_POLL_INTERVAL=100ms

# Every sandbox's api and worker share one Postgres (max_connections=300 in
# docker-compose.yml). The app default of 20 per process would let a handful
# of busy sandboxes starve the rest.
DATABASE_MAX_OPEN_CONNS=5

# ---- Downstream services -----------------------------------------------------
# One WireMock prefix per downstream, under this sandbox's prefix:
#   <SVC>_URL=http://localhost:59999/${HARNESS_MOCK_PREFIX}/<svc>
# (HARNESS_MOCK_PREFIX is set by lib.sh before this file is sourced; stubs in
# _harness/mocks are written WITHOUT it and get it added when pushed.)
# None today: no context makes an outbound HTTP call yet. When one does, add
# its URL here, its stubs in _harness/mocks/<svc>.json, and a row in
# docs/agent/downstream-services.md (skill: add-downstream-stub).

# ---- Shared infra (one stack for every sandbox; see docker-compose.yml) -------
HARNESS_MOCK_URL=http://localhost:59999
HARNESS_KAFKA_BROKERS=localhost:59092
HARNESS_PG_PORT=55432
HARNESS_PG_USER=myapp
HARNESS_PG_PASSWORD=harness-fake-password
# Base topics each sandbox gets (as $KAFKA_TOPIC_PREFIX.<topic>, plus .retry.1
# and .dlq), so consumers never start against a missing topic.
HARNESS_TOPICS="customer.v1.events order.v1.events"
