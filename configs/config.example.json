{
  "env": "prod",
  "http": {
    "addr": ":8080",
    "read_timeout": 10000000000,
    "write_timeout": 15000000000,
    "shutdown_timeout": 20000000000
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "dsn": "postgres://myapp:myapp@localhost:5432/myapp?sslmode=disable",
    "max_open_conns": 20,
    "max_idle_conns": 10,
    "conn_max_lifetime": 1800000000000
  },
  "kafka": {
    "brokers": ["localhost:9092"],
    "group_id": "myapp"
  },
  "outbox": {
    "poll_interval": 1000000000,
    "batch_size": 100
  }
}
