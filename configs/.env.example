# Copy to .env and adjust. Every value here overrides configs/config.json.

APP_ENV=dev
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=20s

LOG_LEVEL=info      # debug | info | warn | error
LOG_FORMAT=text     # text | json

# Leave empty for the in-memory profile (no DB needed).
DATABASE_URL=
# DATABASE_URL=postgres://myapp:myapp@localhost:5432/myapp?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m

# Leave empty for the in-process event bus.
KAFKA_BROKERS=
# KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=myapp

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
